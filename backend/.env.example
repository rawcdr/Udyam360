# ============================================================
# Udyam360 Backend Environment Configuration
# ============================================================

ENVIRONMENT=development

# Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER=gemini
GEMINI_REQUEST_TIMEOUT_SECONDS=30
ADVISOR_ENABLED=True

# Master Cryptographic Secrets
SECRET_KEY=udyam360-enterprise-sync-secret-key-2026
KYC_ENCRYPTION_KEY=udyam360-kyc-master-vault-2026

# OTP Provider: 'mock' (non-prod only) or 'sms' (prod)
OTP_PROVIDER=mock

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# OCR Engine
OCR_PROVIDER=auto
