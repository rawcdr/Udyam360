# ============================================================
# Udyam360 - Production & Development Environment Configuration
# Airtel SYNC Hackathon 2026 - Enterprise Track A
# ============================================================

# Environment Mode: 'development', 'test', or 'production'
ENVIRONMENT=development

# LLM & Advisor Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER=gemini
GEMINI_REQUEST_TIMEOUT_SECONDS=30
ADVISOR_ENABLED=True

# Master Cryptographic Secrets
# CRITICAL: In production, generate strong random strings using `openssl rand -hex 32`
SECRET_KEY=udyam360-enterprise-sync-secret-key-2026
KYC_ENCRYPTION_KEY=udyam360-kyc-master-vault-2026

# OTP Provider Configuration: 'mock' (dev/test only) or 'sms' (production)
# NOTE: Using 'mock' when ENVIRONMENT=production triggers a hard RuntimeError crash
OTP_PROVIDER=mock

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# OCR Engine: 'auto', 'winocr', 'rapidocr'
OCR_PROVIDER=auto

